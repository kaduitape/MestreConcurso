# Copy this file to .env only on the VPS and replace every placeholder.
# Never commit the real .env file.
ENVIRONMENT=production
DEBUG=false

# The frontend is published on port 80. Nginx proxies /api/v1 to the private API.
FRONTEND_PORT=80
VITE_API_URL=/
FRONTEND_URL=https://app.seu-dominio.com.br
BACKEND_URL=https://app.seu-dominio.com.br
CORS_ORIGINS=https://app.seu-dominio.com.br
ALLOWED_HOSTS=app.seu-dominio.com.br

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_NO_MINIMO_32_CARACTERES
MYSQL_DATABASE=mestre_concurso
MYSQL_USER=mestre
MYSQL_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
MYSQL_ROOT_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_FORTE

# The seed creates this initial administrator. Change its password after login.
BOOTSTRAP_ADMIN_EMAIL=admin@seu-dominio.com.br
BOOTSTRAP_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
BOOTSTRAP_ADMIN_NAME=Administrador

# Set production SMTP. MailHog is not exposed by the VPS override.
EMAIL_BACKEND=smtp
EMAIL_FROM="Game of Concursos <nao-responda@seu-dominio.com.br>"
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=SUBSTITUA
SMTP_PASSWORD=SUBSTITUA
SMTP_TLS=true
SMTP_SSL=false

LOG_LEVEL=INFO
LOG_FORMAT=json
WORKER_CONCURRENCY=2
