# =============================================================================
# CONCURSO MESTRE IA — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env real.
# =============================================================================

# --- Aplicação --------------------------------------------------------------
APP_NAME="Concurso Mestre IA"
ENVIRONMENT=development                 # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hosts aceitos pelo TrustedHostMiddleware ("*" apenas em desenvolvimento)
ALLOWED_HOSTS=*

# --- Segurança --------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-em-producao-com-token-aleatorio-de-64-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- Banco de dados ---------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=mestre_concurso
MYSQL_USER=mestre
MYSQL_PASSWORD=mestre_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false
# Opcional: sobrescreve a URL montada a partir das variáveis acima
# DATABASE_URL=mysql+asyncmy://mestre:mestre_dev_password@mysql:3306/mestre_concurso

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CACHE_DEFAULT_TTL=300

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_PASSWORD_RESET=5/hour

# --- E-mail -----------------------------------------------------------------
EMAIL_BACKEND=console                   # console | smtp
EMAIL_FROM="Concurso Mestre IA <nao-responda@mestreconcurso.com.br>"
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false

# --- Observabilidade --------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json | console
METRICS_ENABLED=false
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Uploads / Storage (Fase 3) --------------------------------------------
STORAGE_BACKEND=local                   # local | s3
STORAGE_LOCAL_PATH=/var/lib/mestre/uploads
MAX_UPLOAD_SIZE_MB=30
MAX_PDF_PAGES=400
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Vetores / RAG (Fase 3) -------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
EMBEDDING_DIMENSIONS=1536

# --- Provedores de IA (Fase 3+) --------------------------------------------
# Nenhuma chave é obrigatória na Fase 1. O modelo ativo por feature é definido
# no painel administrativo (tabelas ai_providers / ai_models), não no código.
AI_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MONTHLY_BUDGET_USD=0

# --- Integrações externas (fases futuras) ----------------------------------
YOUTUBE_API_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Seed / Bootstrap -------------------------------------------------------
# Usado por `make seed`. Em produção defina uma senha forte e troque no 1º login.
BOOTSTRAP_ADMIN_EMAIL=admin@mestreconcurso.com.br
BOOTSTRAP_ADMIN_PASSWORD=Admin@Mestre123
BOOTSTRAP_ADMIN_NAME=Administrador

# --- Frontend (build-time, prefixo VITE_) ----------------------------------
VITE_API_URL=http://localhost:8000
VITE_APP_NAME="Concurso Mestre IA"
